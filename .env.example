PORT=3000
# PostgreSQL (Aiven): the Service URI, and the CA certificate downloaded from the service page (path relative to this folder)
PG_URL=postgres://<user>:<password>@<host>:<port>/defaultdb?sslmode=require
PG_CA=certs/aiven-ca.pem
DISCORD_TOKEN=
CLIENT_ID=
# Optional: register slash commands to one server only (updates instantly while testing)
DEV_GUILD_ID=
# Optional: folder of the roster screen recordings (scripts/roster-video.js latest)
ROSTER_VIDEO_DIR=
